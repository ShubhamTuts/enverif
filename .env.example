APP_NAME=Enverif
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_TIMEZONE=UTC

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=enverif
DB_USERNAME=enverif
DB_PASSWORD=enverif

SESSION_DRIVER=file
SESSION_LIFETIME=120
CACHE_STORE=file
QUEUE_CONNECTION=sync

ENVERIF_RUNTIME_MODE=shared
ENVERIF_TICK_BUDGET=45
ENVERIF_WEB_CRON_ENABLED=false
ENVERIF_WEB_CRON_SECRET=

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_FROM_ADDRESS=hello@example.com
MAIL_FROM_NAME="${APP_NAME}"

ENVERIF_DEFAULT_PROVIDER=openai
ENVERIF_MAX_STEPS=40
ENVERIF_MAX_RUNTIME_SECONDS=900
ENVERIF_MAX_COST_USD=10
ENVERIF_MAX_DELEGATION_DEPTH=3
